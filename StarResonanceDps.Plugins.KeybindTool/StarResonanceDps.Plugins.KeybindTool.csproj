    <EmbeddedResource Update="Properties\Resources.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.Plugins.KeybindTool.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
